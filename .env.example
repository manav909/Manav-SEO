# Server-only secrets. Never prefix these with VITE_: anything VITE_* that the
# frontend reads is shipped to every browser. Set the real values in Vercel
# (Project Settings > Environment Variables) and in a local .env / .env.bridge.
BRIDGE_URL=
BRIDGE_SECRET=
BRIDGE_READ_TOKEN=
# Vercel sends this as "Authorization: Bearer <CRON_SECRET>" on the daily cron.
CRON_SECRET=
# Comma-separated owner emails. Once set, only owners and active staff_members
# can use the team portal and API; owners alone see admin, revenue and staff settings.
# Leave empty to keep the old behaviour (any signed-in account is treated as owner).
OWNER_EMAILS=
# Emails clients their sign-in links (/c/login). Without it, links aren't sent.
RESEND_API_KEY=
# Optional: the site address used in client sign-in links (defaults to this deployment's domain).
APP_URL=
# AI visibility: each assistant is checked only when its key is set.
OPENAI_API_KEY=
PERPLEXITY_API_KEY=
GEMINI_API_KEY=
# Optional: Google PageSpeed key for weekly mobile-speed checks (works without, at low volume).
PAGESPEED_API_KEY=

# Public frontend config (safe to expose)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
