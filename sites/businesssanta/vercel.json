{
  "cleanUrls": true,
  "trailingSlash": false,
  "headers": [
    {
      "source": "/portal",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    },
    {
      "source": "/portal/(.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        },
        {
          "key": "Cache-Control",
          "value": "private, no-store"
        }
      ]
    },
    {
      "source": "/",
      "headers": [
        {
          "key": "Vary",
          "value": "User-Agent"
        }
      ]
    },
    {
      "source": "/assets/img/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, stale-while-revalidate=86400"
        }
      ]
    },
    {
      "source": "/assets/video/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, stale-while-revalidate=86400"
        }
      ]
    },
    {
      "source": "/assets/js/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/portal/in/:t",
      "destination": "/api/portal?a=open&t=:t"
    },
    {
      "source": "/",
      "has": [
        {
          "type": "header",
          "key": "user-agent",
          "value": ".*Mobile.*"
        }
      ],
      "missing": [
        {
          "type": "query",
          "key": "desk"
        }
      ],
      "destination": "/home-phone"
    },
    {
      "source": "/",
      "destination": "/home-desktop"
    }
  ],
  "redirects": [
    {
      "source": "/home",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/home/",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/m",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/m.html",
      "destination": "/",
      "permanent": true
    }
  ],
  "functions": {
    "api/portal-scan.mjs": {
      "maxDuration": 90
    },
    "api/portal.mjs": {
      "maxDuration": 120
    },
    "api/portal-cron.mjs": {
      "maxDuration": 300
    }
  },
  "crons": [
    {
      "path": "/api/portal-cron",
      "schedule": "17 10 * * *"
    }
  ]
}
